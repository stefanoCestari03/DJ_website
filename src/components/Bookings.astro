---
import { booking } from "../data/site";
---

<section id="bookings" class="section">
  <div class="wrap">
    <div class="head reveal">
      <p class="eyebrow">03 — Bookings</p>
      <h2 class="display head__title">Get In<br />Touch</h2>
    </div>

    <div class="contact reveal">
      <p class="contact__label eyebrow">{booking.label}</p>
      <a href={`mailto:${booking.email}`} class="contact__email link">
        {booking.email}
      </a>
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(2rem, 6vw, 4rem);
  }
  .head__title {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
  }

  .contact {
    border-top: 1px solid var(--color-line);
    padding-top: 1.5rem;
  }
  .contact__label {
    margin-bottom: 1rem;
  }
  .contact__email {
    font-weight: 700;
    letter-spacing: -0.02em;
    font-size: clamp(1.6rem, 6vw, 3rem);
    text-transform: lowercase;
    word-break: break-all;
  }
</style>
