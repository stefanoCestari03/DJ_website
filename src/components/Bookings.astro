---
import { bookings } from "../data/site";
---

<section id="bookings" class="section">
  <div class="wrap">
    <div class="head reveal">
      <p class="eyebrow">03 — Bookings</p>
      <h2 class="display head__title">Get In<br />Touch</h2>
    </div>

    <dl class="grid">
      {
        bookings.map((b) => (
          <div class="cell reveal">
            <dt class="cell__region eyebrow">{b.region}</dt>
            {b.name && b.name !== "—" && <dd class="cell__name">{b.name}</dd>}
            <dd class="cell__email">
              <a href={`mailto:${b.email}`} class="link">{b.email}</a>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(2rem, 6vw, 4rem);
  }
  .head__title {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 2.5rem 1.5rem;
    margin: 0;
  }

  .cell {
    border-top: 1px solid var(--color-line);
    padding-top: 1rem;
  }
  .cell__region {
    margin-bottom: 0.75rem;
  }
  .cell__name {
    margin: 0 0 0.2rem;
    font-weight: 500;
  }
  .cell__email {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    word-break: break-all;
  }
</style>
