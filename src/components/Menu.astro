---
import { site, socials } from "../data/site";

const nav = [
  { label: "Tour", href: "#tour" },
  { label: "Listen", href: "#listen" },
  { label: "Bookings", href: "#bookings" },
];
---

<header class="header">
  <div class="wrap header__inner">
    <a href="#top" class="header__mark" aria-label={`${site.name} — home`}>
      {site.name}
    </a>

    <button
      id="menu-toggle"
      class="burger"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="menu-overlay"
    >
      <span></span><span></span>
    </button>
  </div>
</header>

<nav id="menu-overlay" class="overlay" aria-hidden="true">
  <ul class="overlay__list">
    {
      nav.map((item, i) => (
        <li style={`--i:${i}`}>
          <a href={item.href} class="overlay__link" data-close>
            <span class="overlay__num">0{i + 1}</span>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="overlay__foot">
    {
      socials.map((s) => (
        <a href={s.href} class="link" target="_blank" rel="noopener">
          {s.label}
        </a>
      ))
    }
  </div>
</nav>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    padding-block: 1.4rem;
    mix-blend-mode: difference;
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .header__mark {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #fff;
  }

  .burger {
    position: relative;
    width: 34px;
    height: 34px;
    background: none;
    border: 0;
    cursor: pointer;
    display: grid;
    place-content: center;
    gap: 7px;
  }
  .burger span {
    display: block;
    width: 26px;
    height: 1.5px;
    background: #fff;
    transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1),
      opacity 0.2s;
  }
  :global(body.menu-open) .burger span:nth-child(1) {
    transform: translateY(4.25px) rotate(45deg);
  }
  :global(body.menu-open) .burger span:nth-child(2) {
    transform: translateY(-4.25px) rotate(-45deg);
  }

  .overlay {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--color-bg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 6rem clamp(1.25rem, 6vw, 5rem) 2.5rem;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s cubic-bezier(0.76, 0, 0.24, 1);
    pointer-events: none;
  }
  :global(body.menu-open) .overlay {
    clip-path: inset(0 0 0 0);
    pointer-events: auto;
  }

  .overlay__list {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(0.25rem, 2vw, 1rem);
  }

  .overlay__link {
    display: flex;
    align-items: baseline;
    gap: 1.25rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: -0.03em;
    line-height: 1;
    font-size: clamp(2.75rem, 12vw, 7rem);
    opacity: 0;
    transform: translateY(0.6em);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
    transition-delay: calc(var(--i) * 60ms);
  }
  :global(body.menu-open) .overlay__link {
    opacity: 1;
    transform: none;
  }
  .overlay__link:hover {
    color: var(--color-muted);
  }
  .overlay__num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 400;
    letter-spacing: 0.1em;
    color: var(--color-muted);
  }

  .overlay__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    opacity: 0;
    transition: opacity 0.4s ease 0.25s;
  }
  :global(body.menu-open) .overlay__foot {
    opacity: 1;
  }
</style>

<script>
  const body = document.body;
  const toggle = document.getElementById("menu-toggle");
  const overlay = document.getElementById("menu-overlay");

  function setMenu(open: boolean) {
    body.classList.toggle("menu-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    toggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    overlay?.setAttribute("aria-hidden", String(!open));
  }

  toggle?.addEventListener("click", () =>
    setMenu(!body.classList.contains("menu-open")),
  );

  overlay?.querySelectorAll("[data-close]").forEach((el) =>
    el.addEventListener("click", () => setMenu(false)),
  );

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setMenu(false);
  });
</script>
