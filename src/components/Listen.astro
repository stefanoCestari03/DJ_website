---
import { embeds } from "../data/site";
---

<section id="listen" class="section">
  <div class="wrap">
    <div class="head reveal">
      <p class="eyebrow">02 — Listen</p>
      <h2 class="display head__title">Selected<br />Sounds</h2>
    </div>

    <div class="grid">
      {
        embeds.map((e) => (
          <figure class="card reveal">
            <figcaption class="card__cap eyebrow">{e.title}</figcaption>
            <div class="card__frame">
              <iframe
                src={e.src}
                loading="lazy"
                title={e.title}
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                allowfullscreen
              />
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(2rem, 6vw, 4rem);
  }
  .head__title {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .card {
    margin: 0;
  }
  .card__cap {
    margin-bottom: 0.9rem;
  }
  .card__frame {
    border: 1px solid var(--color-line);
    background: #111110;
  }
  .card__frame iframe {
    display: block;
    width: 100%;
    height: 352px;
    border: 0;
  }
</style>
