---
import { embeds } from "../data/site";
---

<section id="listen" class="section">
  <div class="wrap">
    <div class="head reveal">
      <p class="eyebrow">02 — Listen</p>
      <h2 class="display head__title">Selected<br />Sounds</h2>
    </div>

    <div class="grid">
      {
        embeds.map((e) => (
          <figure class="card reveal">
            <figcaption class="card__cap eyebrow">{e.title}</figcaption>
            {e.src ? (
              <div class="card__frame">
                <iframe
                  src={e.src}
                  loading="lazy"
                  title={e.title}
                  allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                  allowfullscreen
                />
              </div>
            ) : (
              <a class="card__link" href={e.href} target="_blank" rel="noopener">
                <span>{e.note ?? "Open"}</span>
                <span class="card__link-cta">Open on {e.title} ↗</span>
              </a>
            )}
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: clamp(2rem, 6vw, 4rem);
  }
  .head__title {
    font-size: clamp(2.5rem, 8vw, 5.5rem);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 440px));
    justify-content: start;
    gap: 1.5rem;
  }

  .card {
    margin: 0;
  }
  .card__cap {
    margin-bottom: 0.9rem;
  }
  .card__frame {
    border: 1px solid var(--color-line);
    background: #111110;
  }
  .card__frame iframe {
    display: block;
    width: 100%;
    height: 352px;
    border: 0;
  }

  .card__link {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    min-height: 352px;
    padding: 1.6rem;
    border: 1px solid var(--color-line);
    background: #111110;
    transition: background 0.3s, border-color 0.3s;
  }
  .card__link:hover {
    background: #17171533;
    border-color: #3a3a36;
  }
  .card__link span:first-child {
    max-width: 22ch;
    color: var(--color-muted);
  }
  .card__link-cta {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
